# Release signing. keystore.properties.example is the committed template; the
# real file and any keystore must never be committed - a signing key in the
# repository is a signing key anyone with clone access can publish with.
/keystore.properties
keystore.properties
*.jks
*.keystore

# Firebase project config. Pulled from the Firebase console per environment
# rather than committed, since it names the project a build talks to.
app/google-services.json
.externalNativeBuild
.cxx
local.properties

# APKs mirrored into builds/ by the copy<Variant>ApkToBuilds task.
# Ignored by default: each build is ~12MB, and committing one per build would
# bloat history permanently (git keeps every version forever, even overwritten
# ones). To share builds through the repo instead, delete the line below.
/builds/*.apk
