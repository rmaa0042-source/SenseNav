# Release signing material. Copy to keystore.properties (gitignored) and fill in,
# or set these same four names as environment variables on the build machine.
#
# Generate a key once, and keep it safe: Play identifies an app by its signing
# key, and losing it means you can never update this listing again.
#
#   keytool -genkeypair -v -keystore sensenav-release.jks \
#     -alias sensenav -keyalg RSA -keysize 4096 -validity 10000
#
# Store the .jks outside the repo, or add it to .gitignore. A signing key in
# version control is a signing key everyone with clone access can publish with.

# Path to the keystore, relative to the repository root or absolute.
RELEASE_STORE_FILE=../sensenav-release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=sensenav
RELEASE_KEY_PASSWORD=

# Optional. Overrides the API base URL baked into both build types; leave it out
# to use the default in app/build.gradle.kts. Must end with a trailing slash.
# If the URL is cleartext http, its host also needs a <domain> entry in
# app/src/main/res/xml/network_security_config.xml - verifyReleaseConfig will
# tell you if the two disagree.
#ROUTING_API_BASE_URL=http://34.172.95.142:8000/

# Google Maps SDK key for the release build, if it differs from the debug one.
# Restrict it to this app's package name and signing certificate in the Cloud
# console, otherwise an extracted key can be used by anyone.
MAPS_API_KEY=
