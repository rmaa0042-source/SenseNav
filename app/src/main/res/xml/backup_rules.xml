<?xml version="1.0" encoding="utf-8"?><!--
    The pre-Android-12 half of the same policy as data_extraction_rules.xml:
    none of this app's stored data goes to a cloud backup. See that file for why.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
